# Sem chave, a demonstração usa um interpretador determinístico identificado na UI.
AGENT_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Opcional para um endpoint compatível; nenhuma chave vai para o navegador.
OPENAI_BASE_URL=
PORT=4100
HOST=127.0.0.1
DATABASE_PATH=./data/nexo.sqlite
# Apenas para a demonstração. Não habilitar login simulado em ambiente público.
DEMO_LOGIN=true
